# Enforces the hexagonal dependency direction (ADR-0001):
# dependencies always point INWARD to contracts.
#   personalai_backend  ->  personalai_core  ->  personalai_contracts
# Adapters (providers/*) depend on contracts only; the backend composition root may import them;
# they must never import core, backend, or each other.

[importlinter]
root_packages =
    personalai_contracts
    personalai_core
    personalai_backend
    personalai_provider_ollama
    personalai_provider_openai
    personalai_storage_postgres
    personalai_modality_files
    personalai_tool_builtin
    personalai_tool_mcp

[importlinter:contract:hexagonal-layers]
name = Hexagonal layering (dependencies point inward to contracts)
type = layers
layers =
    personalai_backend
    personalai_core
    personalai_contracts

[importlinter:contract:provider-isolation]
name = Adapters depend only on contracts
type = forbidden
source_modules =
    personalai_provider_ollama
    personalai_provider_openai
    personalai_storage_postgres
    personalai_modality_files
    personalai_tool_builtin
    personalai_tool_mcp
forbidden_modules =
    personalai_core
    personalai_backend
