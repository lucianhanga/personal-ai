{
  "additionalProperties": false,
  "description": "The structured input to a bounded repair retry of an invalid payload.",
  "properties": {
    "attempt": {
      "description": "1-based attempt counter; bounded by the caller.",
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "invalid_payload": {
      "additionalProperties": true,
      "title": "Invalid Payload",
      "type": "object"
    },
    "schema_id": {
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_version": {
      "title": "Target Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "target_version",
    "invalid_payload",
    "errors",
    "attempt"
  ],
  "title": "RepairRequest",
  "type": "object"
}
