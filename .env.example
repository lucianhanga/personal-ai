# Example environment file. Copy to .env and fill in. NEVER commit real secrets.
# All backend settings are PERSONALAI_* env vars (see core/.../config.py: CoreConfig). Everything
# below is OPTIONAL — sensible local-first defaults apply when unset. Remote providers + network
# egress are OFF by default.

# --- Deployment mode (ADR-0010) ---
# local  = single-user dev/personal: zero-login (dev-login), stdio MCP allowed. (default)
# hosted = multi-tenant SaaS: real login required, cookies + CSRF, remote-HTTP MCP only.
# PERSONALAI_APP_MODE=local

# --- Server bind / CORS ---
# PERSONALAI_BIND_HOST=127.0.0.1          # loopback by default
# PERSONALAI_BIND_PORT=8765
# PERSONALAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # CSV; browser origin allowlist
# PERSONALAI_AUTH_TOKEN=                  # optional bearer token; if set, it is REQUIRED (no dev-login)

# --- Models (Ollama default; OpenAI-compatible remote is opt-in) ---
# PERSONALAI_MODEL_PROVIDER=ollama
# PERSONALAI_DEFAULT_MODEL=qwen3.6:35b-a3b
# PERSONALAI_OLLAMA_HOST=http://127.0.0.1:11434
# PERSONALAI_OLLAMA_NUM_CTX=32768         # context window (KV cache) bound
# PERSONALAI_OLLAMA_KEEP_ALIVE=30m        # keep the model warm between turns ("-1" = never unload)
# PERSONALAI_EMBED_PROVIDER=ollama
# PERSONALAI_EMBED_MODEL=qwen3-embedding:0.6b
# PERSONALAI_OPENAI_API_KEY=              # SECRET — only set to enable the remote OpenAI-compatible provider
# PERSONALAI_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Network egress (fail-closed: off + empty allowlist denies all) ---
# PERSONALAI_EGRESS_ENABLED=false
# PERSONALAI_ALLOWED_EGRESS_HOSTS=        # CSV of hosts allowed when egress is enabled
# PERSONALAI_EGRESS_ALLOW_ANY=false       # do NOT enable in hosted

# --- Storage (Postgres + pgvector) ---
# PERSONALAI_DATABASE_URL=postgresql://personalai@127.0.0.1:5432/personalai

# --- Sessions (hosted cookie auth) ---
# PERSONALAI_SESSION_IDLE_SECONDS=86400       # 24h sliding idle window
# PERSONALAI_SESSION_ABSOLUTE_SECONDS=604800  # 7d hard cap

# --- Agent / M8 (ADR-0011) ---
# PERSONALAI_AGENT_MAX_ITERATIONS=8
# PERSONALAI_AGENT_MODE=single            # "single" (loop) | "multi" (planner/researcher/critic
#                                          # graph) | "custom" (reserved). Per-tenant overridable in
#                                          # the UI Agents panel; supersedes AGENT_GRAPH_ENABLED.
# PERSONALAI_AGENT_GRAPH_ENABLED=false    # legacy: true maps to AGENT_MODE=multi when mode is unset
# PERSONALAI_AGENT_HUMAN_GATE=false        # with the graph: suspend each turn for approve/reject
#                                          # (durable; resume via POST /api/v1/chat/{run_id}/resume)
# PERSONALAI_AGENT_ACCURACY_MODE=standard # "standard" | "accurate" (verification-ladder depth)

# --- Memory / RAG / limits ---
# PERSONALAI_MEMORY_ENABLED=true
# PERSONALAI_GROUNDING_ENABLED=true
# PERSONALAI_MAX_UPLOAD_BYTES=10000000
# PERSONALAI_MCP_CONFIG=                  # path to an mcp.json; default ~/.personalai/mcp.json
# PERSONALAI_AUDIT_LOG_PATH=              # JSONL audit sink; empty = in-memory only
